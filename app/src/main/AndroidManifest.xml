<?xml version="1.0" encoding="utf-8"?>
<!-- 通信の権限は持たない（保存は端末内だけ） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".JwHabitsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- JW Library などの「共有」でリンクを受け取る -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.WidgetStyleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".service.TimerStopReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.DailyWidgetReceiver"
            android:exported="true"
            android:label="今日の3つ">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="今日">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NextChapterWidgetReceiver"
            android:exported="true"
            android:label="次の章">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_chapter_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.StudyWidgetReceiver"
            android:exported="true"
            android:label="研究">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/study_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TimerWidgetReceiver"
            android:exported="true"
            android:label="奉仕タイマー">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timer_widget_info" />
        </receiver>

        <!-- 日付が切り替わる時刻にウィジェットを更新する -->
        <receiver
            android:name=".widget.DayRolloverReceiver"
            android:exported="false" />
    </application>
</manifest>
